extends GutTest
## The app icon as the exporters will see it.
##
## Every way this goes wrong is silent. An Android preset that names a missing
## file exports without complaint and the phone shows Godot's robot; a
## foreground layer saved without alpha covers the background and the launcher
## parallax shows one flat plate; a colour picked by eye instead of from the
## palette is invisible in review and wrong on a home screen next to the game.
## So the files are read back from disk -- not through the importer, which would
## hand over whatever it last cached -- and checked for what they promise.

const PRESETS := "res://export_presets.cfg"
const ANDROID_KEYS: Array[String] = [
	"launcher_icons/main_192x192",
	"launcher_icons/adaptive_foreground_432x432",
	"launcher_icons/adaptive_background_432x432",
	"launcher_icons/adaptive_monochrome_432x432",
]
const GENERATOR_MARK := "Generated by tools/generate_icon.py"


func _android_options() -> Dictionary:
	var cfg := ConfigFile.new()
	assert_eq(cfg.load(PRESETS), OK, "export_presets.cfg must parse")
	for section: String in cfg.get_sections():
		if section.ends_with(".options"):
			continue
		if String(cfg.get_value(section, "platform", "")) != "Android":
			continue
		var out := {}
		var options := section + ".options"
		for key: String in cfg.get_section_keys(options):
			out[key] = cfg.get_value(options, key)
		return out
	fail_test("no Android preset in export_presets.cfg")
	return {}


func _load(path: String) -> Image:
	var image := Image.load_from_file(ProjectSettings.globalize_path(path))
	assert_not_null(image, "%s must load as an image" % path)
	return image


## Every colour the generator may use: the game's palette and nothing else.
func _palette() -> Array[Color]:
	return [
		Palette.INK, Palette.SHADOW_PIT, Palette.SHADOW_DEEP, Palette.SHADOW,
		Palette.SHADOW_WARM, Palette.MID, Palette.LIGHT_WARM, Palette.LIGHT,
		Palette.LIGHT_SOFT, Palette.PAPER, Palette.STEEL,
	]


func _in_palette(c: Color) -> bool:
	for p: Color in _palette():
		if p.to_html(false) == c.to_html(false):
			return true
	return false


func test_every_android_launcher_icon_is_set_and_the_size_it_claims() -> void:
	var options := _android_options()
	for key: String in ANDROID_KEYS:
		var path := String(options.get(key, ""))
		assert_ne(path, "", "%s must be set, or the export falls back to the robot" % key)
		if path == "":
			continue
		assert_true(FileAccess.file_exists(path), "%s names %s, which is missing" % [key, path])
		var image := _load(path)
		if image == null:
			continue
		var side := int(key.get_slice("_", key.get_slice_count("_") - 1).get_slice("x", 0))
		assert_eq(image.get_width(), side, "%s width" % key)
		assert_eq(image.get_height(), side, "%s height" % key)


func test_adaptive_layers_are_a_back_plate_and_a_cut_out() -> void:
	var options := _android_options()
	var back := _load(String(options.get(ANDROID_KEYS[2], "")))
	var front := _load(String(options.get(ANDROID_KEYS[1], "")))
	if back == null or front == null:
		return
	var holes := 0
	var solid := 0
	for y: int in range(0, back.get_height(), 4):
		for x: int in range(0, back.get_width(), 4):
			assert_eq(back.get_pixel(x, y).a, 1.0, "the back layer may not be see-through")
			if back.get_pixel(x, y).a < 1.0:
				return
			if front.get_pixel(x, y).a == 0.0:
				holes += 1
			else:
				solid += 1
	# Both, or the launcher's parallax has nothing to slide.
	assert_gt(holes, 0, "the front layer must let the sky through somewhere")
	assert_gt(solid, 0, "the front layer must carry the arch and the figure")


func test_the_icon_is_drawn_from_the_palette() -> void:
	var image := _load(String(_android_options().get(ANDROID_KEYS[0], "")))
	if image == null:
		return
	var strays := {}
	for y: int in image.get_height():
		for x: int in image.get_width():
			var c := image.get_pixel(x, y)
			if c.a > 0.0 and not _in_palette(c):
				strays[c.to_html(false)] = true
	assert_eq(strays.size(), 0, "colours outside Palette: %s" % ", ".join(strays.keys()))


func test_icon_svg_is_the_generated_one() -> void:
	var text := FileAccess.get_file_as_string("res://icon.svg")
	assert_string_contains(text, GENERATOR_MARK, "icon.svg is generated, not hand-edited")
	var fills := RegEx.create_from_string('fill="#([0-9a-fA-F]{6})"')
	var seen := 0
	for m: RegExMatch in fills.search_all(text):
		seen += 1
		assert_true(_in_palette(Color(m.get_string(1))), "icon.svg fill #%s" % m.get_string(1))
	assert_gt(seen, 3, "icon.svg should carry the palette's tones, not one flat colour")
